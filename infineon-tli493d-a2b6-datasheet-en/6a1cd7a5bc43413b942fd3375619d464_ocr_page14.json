{"PageNumber":14,"Angle":0,"RotatedAngle":0,"Height":2526,"Width":1786,"OriginHeight":0,"OriginWidth":0,"Elements":[{"Index":0,"Type":"Discard_type","Text":"TLI493D-A2B6","Level":0,"Polygon":{"LeftBottom":{"X":156,"Y":119},"LeftTop":{"X":156,"Y":81},"RightBottom":{"X":402,"Y":119},"RightTop":{"X":402,"Y":81}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":1,"Type":"header","Text":"infineon","Level":0,"Polygon":{"LeftBottom":{"X":1369,"Y":155},"LeftTop":{"X":1369,"Y":54},"RightBottom":{"X":1663,"Y":155},"RightTop":{"X":1663,"Y":54}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":2,"Type":"title","Text":"#  Specification","Level":0,"Polygon":{"LeftBottom":{"X":156,"Y":233},"LeftTop":{"X":156,"Y":198},"RightBottom":{"X":336,"Y":233},"RightTop":{"X":336,"Y":198}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":3,"Type":"title","Text":"##  3.7 Interface and Timing Description","Level":0,"Polygon":{"LeftBottom":{"X":156,"Y":334},"LeftTop":{"X":156,"Y":294},"RightBottom":{"X":860,"Y":334},"RightTop":{"X":860,"Y":294}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":4,"Type":"paragraph","Text":"This chapter refers to how to set the boundary conditions in order to establish a proper interface communication.","Level":0,"Polygon":{"LeftBottom":{"X":154,"Y":430},"LeftTop":{"X":154,"Y":352},"RightBottom":{"X":1645,"Y":430},"RightTop":{"X":1645,"Y":352}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":5,"Type":"caption","Text":"Table 16 Interface and timing1)","Level":0,"Polygon":{"LeftBottom":{"X":154,"Y":518},"LeftTop":{"X":154,"Y":475},"RightBottom":{"X":636,"Y":518},"RightTop":{"X":636,"Y":475}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":0,"group_type":"FigureOrTableCAPTION"},{"Index":6,"Type":"table","Text":"<table><tr><td>Parameter</td><td>Symbol</td><td>min</td><td>typ</td><td>max</td><td>Unit</td><td>Note/Condition</td></tr><tr><td>End of Conversion /INT pulse</td><td>$t_{INT}$</td><td>1.8</td><td>2.5</td><td>3.2</td><td>μs</td><td>low-active (when activated)</td></tr><tr><td>Time window to read first value (full range)</td><td>$t_{RD1}$</td><td>30</td><td>40</td><td>50</td><td>μs</td><td>read after rising /INT edge</td></tr><tr><td>Time window to read first value (short range)</td><td>$t_{RD1_SR}$</td><td>42</td><td>56</td><td>70</td><td>μs</td><td>read after rising /INT edge</td></tr><tr><td>Time window to read next value (full range)</td><td>$t_{RDn}$</td><td>32</td><td>43</td><td>54</td><td>μs</td><td>consecutive reads</td></tr><tr><td>Time window to read next value (short range)</td><td>$t_{RDn_SR}$</td><td>44</td><td>59</td><td>74</td><td>μs</td><td>consecutive reads</td></tr><tr><td>Internal clock accuracy</td><td>$t_{clk_E}$</td><td>-25</td><td>-</td><td>+25</td><td>%</td><td></td></tr><tr><td colspan=\"7\">$I^{2}C$ timings</td></tr><tr><td>Allowed $I^{2}C$ bit clock $frequency^{2)}$</td><td>$f_{I2C_CLK}$</td><td>-</td><td>400</td><td>1000</td><td>kHz</td><td></td></tr><tr><td>Low period of SCL clock</td><td>$t_{L}$</td><td>0.5</td><td>-</td><td>-</td><td>μs</td><td>1.3 μs for 400-kHz mode</td></tr><tr><td>High period of SCL clock</td><td>$t_{H}$</td><td>0.4</td><td>-</td><td>-</td><td>μs</td><td>0.6 μs for 400-kHz mode</td></tr><tr><td>SDA fall to SCL fall hold time (hold time start condition to clock)</td><td>$t_{STA}$</td><td>0.4</td><td>-</td><td>-</td><td>μs</td><td>0.6 μs for 400-kHz mode</td></tr><tr><td>SCL rise to SDA rise su. time (setup time clock to stop condition)</td><td>$t_{STOP}$</td><td>0.4</td><td>-</td><td>-</td><td>μs</td><td>0.6 μs for 400-kHz mode</td></tr><tr><td>SDA rise to SDA fall hold time (wait time from stop to start cond.)</td><td>$t_{WAIT}$</td><td>0.4</td><td>-</td><td>-</td><td>μs</td><td>0.6 μs for 400-kHz mode</td></tr><tr><td>SDA setup before SCL rising</td><td>$t_{SU}$</td><td>0.1</td><td>-</td><td>-</td><td>μs</td><td></td></tr><tr><td>SDA hold after SCL falling</td><td>$t_{HOLD}$</td><td>0</td><td>-</td><td>-</td><td>μs</td><td></td></tr><tr><td>Fall time SDA/SCL $signal^{3)}$</td><td>$t_{FALL}$</td><td>-</td><td>0.25</td><td>0.3</td><td>μs</td><td></td></tr><tr><td>Rise time SDA/SCL $signal^{3)}$</td><td>$t_{RISE}$</td><td>-</td><td>0.5</td><td>-</td><td>μs</td><td>R = 1.2 kΩ</td></tr></table>","Level":0,"Polygon":{"LeftBottom":{"X":149,"Y":1766},"LeftTop":{"X":149,"Y":523},"RightBottom":{"X":1651,"Y":1766},"RightTop":{"X":1651,"Y":523}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":0,"group_type":"FigureOrTableCAPTION"},{"Index":7,"Type":"paragraph","Text":"1) Not subject to production test - verified by design/characterization","Level":0,"Polygon":{"LeftBottom":{"X":154,"Y":1802},"LeftTop":{"X":154,"Y":1766},"RightBottom":{"X":1035,"Y":1802},"RightTop":{"X":1035,"Y":1766}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":8,"Type":"paragraph","Text":"2) Dependent on R-C-combination on SDA and SCL. Ensure reduced capacitive load for speeds above 400 kHz.","Level":0,"Polygon":{"LeftBottom":{"X":156,"Y":1842},"LeftTop":{"X":156,"Y":1809},"RightBottom":{"X":1540,"Y":1842},"RightTop":{"X":1540,"Y":1809}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":9,"Type":"paragraph","Text":"3) Dependent on used R-C-combination.","Level":0,"Polygon":{"LeftBottom":{"X":154,"Y":1885},"LeftTop":{"X":154,"Y":1855},"RightBottom":{"X":677,"Y":1885},"RightTop":{"X":677,"Y":1855}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":10,"Type":"paragraph","Text":"The fast mode, shown in Figure 7, requires a very strict $I^2C$ behavior synchronized with the sensor conversions and high bit rates. In this mode, a fresh measurement cycle is started immediately after the previous cycle was completed.","Level":0,"Polygon":{"LeftBottom":{"X":152,"Y":2054},"LeftTop":{"X":152,"Y":1933},"RightBottom":{"X":1647,"Y":2054},"RightTop":{"X":1647,"Y":1933}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":11,"Type":"paragraph","Text":"Other modes are available for more relaxed timing and also for a synchronous microcontroller operation of sensor conversions. In these modes, a fresh measurement cycle is only started if it is triggered by an internal or external trigger source.","Level":0,"Polygon":{"LeftBottom":{"X":152,"Y":2191},"LeftTop":{"X":152,"Y":2067},"RightBottom":{"X":1649,"Y":2191},"RightTop":{"X":1649,"Y":2067}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":12,"Type":"paragraph","Text":"In the default measurement configuration (Bx, By, Bz and T), shown in Figure 7, the measurement cycle ends after the temperature measurement.","Level":0,"Polygon":{"LeftBottom":{"X":152,"Y":2281},"LeftTop":{"X":152,"Y":2203},"RightBottom":{"X":1647,"Y":2281},"RightTop":{"X":1647,"Y":2203}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":13,"Type":"paragraph","Text":"In 3-channel measurement configuration (Bx, By and Bz), the temperature channel is not converted and updated. Thus, the measurement cycle ends after the Bz measurement.","Level":0,"Polygon":{"LeftBottom":{"X":154,"Y":2377},"LeftTop":{"X":154,"Y":2299},"RightBottom":{"X":1647,"Y":2377},"RightTop":{"X":1647,"Y":2299}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":14,"Type":"footer","Text":"Data Sheet","Level":0,"Polygon":{"LeftBottom":{"X":156,"Y":2446},"LeftTop":{"X":156,"Y":2420},"RightBottom":{"X":281,"Y":2446},"RightTop":{"X":281,"Y":2420}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":15,"Type":"footer","Text":"15","Level":0,"Polygon":{"LeftBottom":{"X":885,"Y":2446},"LeftTop":{"X":885,"Y":2423},"RightBotto