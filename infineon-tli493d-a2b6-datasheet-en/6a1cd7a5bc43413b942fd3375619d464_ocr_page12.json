tImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":10,"Type":"paragraph","Text":"Example for 8-bit read out: 0101 $1101_{B}$: 0 + 64 + 0 + 16 + 8 + 4 + 0 + 1 = 93 $LSB_{8}$","Level":0,"Polygon":{"LeftBottom":{"X":152,"Y":1079},"LeftTop":{"X":152,"Y":1036},"RightBottom":{"X":1197,"Y":1079},"RightTop":{"X":1197,"Y":1036}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":11,"Type":"paragraph","Text":"Calculation of magnetic flux: 93 LSB$_{8}$ * 2.08 mT/LSB$_{8}$ = 193.4 mT","Level":0,"Polygon":{"LeftBottom":{"X":151,"Y":1127},"LeftTop":{"X":151,"Y":1087},"RightBottom":{"X":1020,"Y":1127},"RightTop":{"X":1020,"Y":1087}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":12,"Type":"title","Text":"###  3.5 Temperature Measurement","Level":0,"Polygon":{"LeftBottom":{"X":152,"Y":1344},"LeftTop":{"X":152,"Y":1304},"RightBottom":{"X":776,"Y":1344},"RightTop":{"X":776,"Y":1304}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":13,"Type":"paragraph","Text":"By default, the temperature measurement is activated. The temperature measurement can be disabled if it is not needed and to increase the speed of repetition of the magnetic values.","Level":0,"Polygon":{"LeftBottom":{"X":152,"Y":1438},"LeftTop":{"X":152,"Y":1362},"RightBottom":{"X":1644,"Y":1438},"RightTop":{"X":1644,"Y":1362}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":14,"Type":"title","Text":"#  Table 13 Temperature Measurement Characteristics$^{1)}$","Level":0,"Polygon":{"LeftBottom":{"X":147,"Y":1524},"LeftTop":{"X":147,"Y":1486},"RightBottom":{"X":947,"Y":1524},"RightTop":{"X":947,"Y":1486}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":15,"Type":"table","Text":"<table><tr><td>Parameter</td><td>Symbol</td><td>min</td><td>typ</td><td>max</td><td>Unit</td><td>Note/Condition</td></tr><tr><td>Digital value ![](330,1601,360,1631)  25°C</td><td>$T_{25}$</td><td>1000</td><td>1180</td><td>1360</td><td>$LSB_{12}$</td><td></td></tr><tr><td>Temperature resolution, 12-bit</td><td>$T_{Res12}$</td><td>0.21</td><td>0.24</td><td>0.27</td><td>$K/LSB_{12}$</td><td>referring to $T_{j}$</td></tr><tr><td>Temperature resolution, 8-bit</td><td>$T_{Res8}$</td><td>-</td><td>3.84</td><td>-</td><td>$K/LSB_{8}$</td><td>referring to $T_{j}$</td></tr></table>","Level":0,"Polygon":{"LeftBottom":{"X":147,"Y":1754},"LeftTop":{"X":147,"Y":1534},"RightBottom":{"X":1638,"Y":1754},"RightTop":{"X":1638,"Y":1534}},"InsetImageName":"","Elements":null,"ImagePath":"images/61366da6776e56473fa43c85e2b9de48-image.png","group_id":-1,"group_type":""},{"Index":16,"Type":"paragraph","Text":"1) The temperature measurement is not trimmed on the sensor. An external $\\mu$C can measure the sensor during module production and implement external trimming to gain higher accuracies.","Level":0,"Polygon":{"LeftBottom":{"X":154,"Y":1817},"LeftTop":{"X":154,"Y":1751},"RightBottom":{"X":1636,"Y":1817},"RightTop":{"X":1636,"Y":1751}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":17,"Type":"paragraph","Text":"Temperature values are based on 12 bit resolution. Please note: only bit 11 ... 2 are listed in the bitmap registers.","Level":0,"Polygon":{"LeftBottom":{"X":197,"Y":1857},"LeftTop":{"X":197,"Y":1819},"RightBottom":{"X":1597,"Y":1857},"RightTop":{"X":1597,"Y":1819}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":18,"Type":"title","Text":"##  Table 14 Temperature conversion table for 12Bit","Level":0,"Polygon":{"LeftBottom":{"X":147,"Y":1968},"LeftTop":{"X":147,"Y":1928},"RightBottom":{"X":881,"Y":1968},"RightTop":{"X":881,"Y":1928}},"InsetImageName":"","Elements":null,"ImagePath":"","group_id":-1,"group_type":""},{"Index":19,"Type":"paragraph","Text":"The bits MSB to Bit2 are read out from the tempera